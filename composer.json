{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "openspout/openspout": "^5.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts-descriptions": {
        "lint:callbacks": "Fails when a Collection callback is a built-in with an optional second parameter, such as map(intval(...)): Collections pass the key as that argument.",
        "lint:migrations": "Fails when the branch changes a migration already on main; add a new migration instead.",
        "lint:folders": "Fails when a controller or form request sits directly in app/Http/Controllers or app/Http/Requests instead of an area folder.",
        "lint:scopes": "Fails when a model declares query scopes; reusable queries go in the model's builder in app/Models/Builders.",
        "lint:builders": "Fails when a public builder method in app/Models/Builders doesn't start with return $this->scoped(...).",
        "lint:browser-tests": "Fails when a browser test in tests/Browser still calls screenshot(), debug() or pause().",
        "test:failures": "Runs the tests (or the paths given) and prints one line per failure or error: file:line, test name and message."
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "@lint:callbacks",
            "@lint:migrations",
            "@lint:folders",
            "@lint:scopes",
            "@lint:builders",
            "@lint:browser-tests",
            "npm run build",
            "npm run types:check",
            "@test"
        ],
        "lint:callbacks": "bin/lint-callbacks.sh",
        "lint:migrations": "bin/lint-migrations.sh",
        "lint:folders": "bin/lint-folders.sh",
        "lint:scopes": "bin/lint-scopes.sh",
        "lint:builders": "@php bin/lint-builders.php",
        "lint:browser-tests": "bin/lint-browser-tests.sh",
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php -r \"file_put_contents('storage/logs/testing.log', '');\"",
            "@php artisan test --parallel"
        ],
        "test:readable": [
            "env -u CLAUDECODE -u AI_AGENT -u CLAUDE_CODE_ENTRYPOINT php artisan test --compact"
        ],
        "test:failures": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-failures.sh"
        ],
        "test:mutate": [
            "Composer\\Config::disableProcessTimeout",
            "env -u CLAUDECODE -u AI_AGENT -u CLAUDE_CODE_ENTRYPOINT XDEBUG_MODE=coverage herd coverage vendor/bin/pest --mutate --everything --parallel --min=80 --ignore=app/Http/Controllers/Settings,app/Http/Requests/Settings,app/Actions/Fortify,app/Concerns,app/Http/Middleware/HandleAppearance.php,app/Http/Middleware/HandleInertiaRequests.php,app/Providers/AppServiceProvider.php,app/Providers/FortifyServiceProvider.php,app/Http/Controllers/Controller.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-install-cmd": [
            "git config core.hooksPath > /dev/null || git config core.hooksPath .githooks || true"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
