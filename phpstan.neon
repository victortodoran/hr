includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 8

    # Pest's arch() DSL resolves preset()/expect() through magic methods that
    # PHPStan can't type. The file is itself a static check, so it is skipped.
    excludePaths:
        - tests/Unit/ArchitectureTest.php
